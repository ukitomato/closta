// 違反サンプル (等価経路): 許可されていない Agent SDK の書き込み系 API を **alias 経由**で呼ぶ。
// 項目14 は許可外の名前の**値の import** そのものを違反にする (023 / AD-062 Decision 5。research R-08)。
// このため `const r = tagSession; r()` の再束縛でも、import の時点で発火する。
import { tagSession } from '@anthropic-ai/claude-agent-sdk'

const tag = tagSession

export async function forbiddenWriteViaAlias(sessionId: string): Promise<unknown> {
  return tag(sessionId, 'tag')
}
