/**
 * 等価経路サンプル (項目 18 / X-5 SH-010 / AD-043 Decision 2)。
 *
 * **`JSON` を多段の別名に代入してから parse を呼ぶ形。** 調停役スレッドの置き場 (`supervisor*.ts`) にあるが、
 * 項目 18 は `JSON` の `parse` の綴り (直接参照 / ブラケット / 分割代入) を見るだけでデータフローを追わないので、
 * `codec.parse` は `JSON` の parse として見分けられない。**この経路はどの機械検証も捕まえない** — `detectors: ['none']`。
 * 理由と代替は expected.mjs の UNDETECTED_NOTES['supervisor-json-parse-multi-alias'] に記録する (SC-017)。
 */
const builtin = JSON
const codec = builtin

export function relay(body: string): unknown {
  return codec.parse(body)
}
