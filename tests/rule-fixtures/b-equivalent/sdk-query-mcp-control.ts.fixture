import { query } from '@anthropic-ai/claude-agent-sdk'

/**
 * 違反サンプル (O-5 / AD-048 Decision 2 / AD-036 §4 P3)。
 *
 * **`Query` の MCP の操作のメソッドを呼ぶ。** アプリは MCP・プラグイン・スキルを操作しない。
 * AD-048 Decision 2 で `QUERY_MUTATION_METHODS` に足した名前の 1 つ (`reconnectMcpServer`) だけを呼び、
 * 項目 16 の他の綴り (昇格値・昇格キー) を含めない — P3 の列挙が新しい名前に効くことを単独で確かめる
 * (015 research R-06 (3))。
 */
export async function bad(): Promise<void> {
  const q = query({ prompt: 'hi' })
  await q.reconnectMcpServer('server')
}
