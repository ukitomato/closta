/**
 * 等価経路サンプル (X-5 SH-010 / 既存の穴 / design-gate R1 platform-boundary L-003)。
 *
 * **agents が import 文を経ずに Node 標準モジュール (`node:fs`) を取る形。**
 * agents の標準モジュール禁止は ESLint にしか無く (全標準モジュールは `boundaries/dependencies`。
 * `no-restricted-imports` はパス操作・プロセス起動・プラットフォーム判定・`worker_threads` の綴りだけ)、
 * どちらも import (と require) の依存しか見ない。dependency-cruiser は `process.getBuiltinModule()` を依存として
 * 検出し、023 (BE-030) で足した `agents-not-to-core` が発火する — `detectors: ['depcruise']`。
 */
export function readText(file: string): string {
  const fs = process.getBuiltinModule('node:fs')
  return fs.readFileSync(file, 'utf8')
}
