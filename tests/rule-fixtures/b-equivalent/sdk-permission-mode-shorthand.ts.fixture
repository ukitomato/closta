import { query } from '@anthropic-ai/claude-agent-sdk'

/**
 * 違反サンプル (X-4 / AD-041 (a) / SH-010)。
 *
 * **shorthand の `{ permissionMode }` で渡す形。** `permissionMode:` の綴りが現れないので、
 * キー + コロンだけを見る検査は素通しする。項目 16 は shorthand も値位置として違反にする。
 */
export function bad(permissionMode: string): void {
  void query({
    prompt: 'hi',
    options: { permissionMode }
  })
}
