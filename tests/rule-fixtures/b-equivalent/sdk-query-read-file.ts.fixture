import { query } from '@anthropic-ai/claude-agent-sdk'

/**
 * 違反サンプル (016 / AD-049 Decision 6 / AD-036 §4 P3)。
 *
 * **`Query` の `readFile` を呼ぶ。** `QUERY_MUTATION_METHODS` に足した名前の 1 つ (`readFile`) だけを呼び、
 * 項目 16 の他の綴り (昇格値・昇格キー) を含めない。
 */
export async function bad(): Promise<void> {
  const q = query({ prompt: 'hi' })
  await q.readFile('a.txt')
}
