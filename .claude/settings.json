{
  "env": {
    "PYTHONUTF8": "1",
    "LANG": "ja_JP.UTF-8",
    "WINELOADERNOEXEC": "1"
  },
  "autoCompactWindow": 300000,
  "permissions": {
    "allow": [
      "Edit(/.claude/skills/cl-spec/**)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(ConvertFrom-Json *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-CimInstance *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm depcruise *)",
      "Bash(pnpm check:constitution *)",
      "Bash(pnpm test *)",
      "Bash(source .specify/scripts/gate-common.sh*)",
      "Bash(. .specify/scripts/gate-common.sh*)",
      "Bash(gate_common::*)",
      "Bash(bash .specify/scripts/*)",
      "Bash(node node_modules/*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git symbolic-ref *)",
      "Bash(git ls-files *)",
      "Bash(git fetch origin*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(comm *)",
      "Bash(sort *)",
      "Bash(tr *)",
      "Bash(date *)",
      "Bash(mkdir -p specs/*)",
      "Bash(mkdir -p .specify/*)",
      "Bash(mv specs/*)",
      "Bash(mv .specify/*)",
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph.cmd prompt-hook"
          }
        ]
      }
    ]
  }
}
