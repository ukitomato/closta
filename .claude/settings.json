{
  "env": {
    "PYTHONUTF8": "1",
    "LANG": "ja_JP.UTF-8",
    "WINELOADERNOEXEC": "1"
  },
  "autoCompactWindow": 300000,
  "permissions": {
    "allow": [
      "Edit(/.claude/skills/cl-spec/**)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(ConvertFrom-Json *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-CimInstance *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm depcruise *)",
      "Bash(pnpm check:constitution *)",
      "Bash(pnpm test *)",
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph.cmd prompt-hook"
          }
        ]
      }
    ]
  }
}
