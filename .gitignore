# ---- Dependencies ----
node_modules/
.pnpm-store/

# ---- Build output ----
dist/
dist-electron/
out/
release/
*.tsbuildinfo

# ---- Test / coverage ----
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---- Tooling caches ----
.vite/
.cache/
.turbo/
.eslintcache

# ---- Secrets / local environment (P-5: 長期資格情報を永続化しない) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---- Logs ----
logs/
*.log

# ---- Local runtime data (sessionStore ミラー等) ----
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Editor / OS ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
# .vscode/ は追跡する。公式 scaffold が生成する launch.json (デバッグ構成) を
# 共有するため (AD-023 の検証済み事実)。個人設定は settings.json に寄せず、
# 必要になった時点で個別に除外する。

# ---- Claude Code / Spec Kit ----
# .claude/ と .specify/ は SSoT (Constitution / subagent / gate スクリプト) を含むため追跡する。
# 個人環境依存の上書きのみ除外する。
.claude/settings.local.json

# spec-gate の --force 退避ファイル
*.bak.*

# テストが作る一時ディレクトリ
tests/.tmp/

# ルール検証ランナーが一時展開する違反サンプル
src/**/__rulecheck__/
