# ---- Dependencies ----
node_modules/
.pnpm-store/

# ---- Build output ----
dist/
dist-electron/
out/
release/
*.tsbuildinfo

# ---- Test / coverage ----
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---- Tooling caches ----
.vite/
.cache/
.turbo/
.eslintcache

# ---- Secrets / local environment (P-5: 長期資格情報を永続化しない) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---- Logs ----
logs/
*.log

# ---- Local runtime data (sessionStore ミラー等) ----
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Editor / OS ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
# .vscode/ は追跡する。公式 scaffold が生成する launch.json (デバッグ構成) を
# 共有するため (AD-023 の検証済み事実)。個人設定は settings.json に寄せず、
# 必要になった時点で個別に除外する。

# ---- Claude Code / Spec Kit ----
# .claude/ と .specify/ は SSoT (Constitution / subagent / gate スクリプト) を含むため追跡する。
# 個人環境依存の上書きのみ除外する。
.claude/settings.local.json

# spec-gate の --force 退避ファイル
*.bak.*

# skills インストーラが .claude/skills/ と同じ内容を書き出すミラー。
# 読み手がいないので追跡しない (再生成されても差分に出ない)。
.agents/

# テストが作る一時ディレクトリ
tests/.tmp/

# ルール検証ランナーが一時展開する違反サンプル
src/**/__rulecheck__/

# ---- gate が生成する世代とバックアップ ----
# gate は iteration ごとの生 output と、上書き前のバックアップをディスクに残す。
# リポジトリに要るのは**最終版だけ**である (`analyze.md` / `design-gate.md` /
# `<reviewer>.<gate>.md` / `.gate-verdict-<gate>.json`)。
# 世代を追跡すると、1 feature あたり数十ファイルが恒久的に積む。
#
# **round / iter を跨いで必要な情報は、追跡される最終版の中に持たせる。**
# pr-gate の Round N-1 引継ぎと convergence 判定は `.gate-verdict-pr.json` の
# `round_history[]` から引く (下の `*.round[0-9]*` で snapshot は追跡されないため、
# snapshot を一次情報にすると clone 直後に round が 1 に戻る)。
# code-gate の収束判定は `.gate-verdict-code.json` の `iter_history[]` から引く。
specs/**/*.bak
specs/**/*.round[0-9]*
specs/**/*-round[0-9]*
specs/**/*.iter[0-9]*
specs/**/*-gate.md.[0-9]*
specs/**/.*-scope.txt
# code-gate / pr-gate が reviewer に渡すために書き出す diff (再実行のたびに作り直す)
specs/**/.*-gate.diff
