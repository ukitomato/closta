{
  "name": "Closta New UI",
  "themes": [
    {
      "name": "Closta New UI Dark",
      "mode": "dark",
      "font.size": 13,
      "font.family": "Segoe UI",
      "mono_font.family": "JetBrains Mono",
      "mono_font.size": 12.5,
      "radius": 4,
      "radius.lg": 6,
      "shadow": false,
      "colors": {
        "background": "#1E1F22",
        "foreground": "#DFE1E5",
        "border": "#393B40",
        "input.border": "#4E5157",
        "ring": "#3574F0",
        "caret": "#CED0D6",
        "selection.background": "#214283",
        "muted.background": "#2B2D30",
        "muted.foreground": "#868A91",
        "accent.background": "#393B40",
        "accent.foreground": "#DFE1E5",
        "primary.background": "#3574F0",
        "primary.hover.background": "#3369D6",
        "primary.active.background": "#2E5FC4",
        "primary.foreground": "#FFFFFF",
        "secondary.background": "#2B2D30",
        "secondary.hover.background": "#393B40",
        "secondary.foreground": "#DFE1E5",
        "popover.background": "#2B2D30",
        "popover.foreground": "#DFE1E5",
        "list.background": "#2B2D30",
        "list.hover.background": "#393B40",
        "list.active.background": "#2E436E",
        "title_bar.background": "#2B2D30",
        "title_bar.border": "#1E1F22",
        "status_bar.background": "#2B2D30",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#5A5D6380",
        "scrollbar.thumb.hover.background": "#6F737A",
        "link": "#548AF7"
      },
      "highlight": {
        "editor.foreground": "#BCBEC4",
        "syntax": {
          "keyword": { "color": "#CF8E6D" },
          "boolean": { "color": "#CF8E6D" },
          "variable.special": { "color": "#CF8E6D" },
          "number": { "color": "#2AACB8" },
          "string": { "color": "#6AAB73" },
          "string.escape": { "color": "#CF8E6D" },
          "string.regex": { "color": "#6AAB73" },
          "constant": { "color": "#C77DBB" },
          "attribute": { "color": "#B3AE60" },
          "comment": { "color": "#7A7E85" },
          "comment.doc": { "color": "#5F826B" }
        }
      }
    }
  ]
}
